<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false">
	<property name="LOG_LEVEL_PATTERN" value="%X{} %5p" />
	<property name="LOG_FILE" value="${LOG_FILE:-log/primemover-runner.log}"/>

	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>
	<include resource="org/springframework/boot/logging/logback/console-appender.xml" />
	<include resource="org/springframework/boot/logging/logback/file-appender.xml" />

	<!-- NEVER below INFO. At DEBUG, Spring logs every request body via
	     toString(), and the generated Multilogin model (UserSignInRequest) has a
	     Lombok toString that includes the password. Under the `local` profile
	     (root DEBUG, the profile the VM runs) that put the Multilogin credentials
	     into log/primemover-runner.log and Loki. The models are generated at
	     build time, so this is the only place to stop it.

	     The whole package, not just RestTemplate: Spring 6 emits the same
	     "Writing [...]" line under org.springframework.web.HttpLogging as well,
	     which a RestTemplate-only pin (the first attempt) did not cover. -->
	<logger name="org.springframework.web" level="INFO"/>

	<!-- Reduce noise from verbose libraries -->
	<logger name="primemover.api" level="WARN" />
	<logger name="org.apache" level="WARN"/>
	<logger name="org.littleshoot" level="WARN"/>
	<!-- BrowserUp renamed this package: the runner embeds com.browserup.bup, and
	     net.lightbody produces ZERO lines, so the rule below it was silencing a
	     package that is no longer present. Measured over 400k lines of the
	     2026-08-27 logs, the proxy/netty stack was 71.5% of all runner output
	     (com.browserup 18191, io.netty.handler.ssl 6649, o.l.proxy 2788 in the
	     same sample), almost entirely TLS handshake chatter from hosts that
	     refuse the MITM recorder's certificate. That is expected behaviour for
	     certificate-pinned hosts and fails no jobs (48,056 such lines and zero job
	     failures on 2026-08-24), but it buries real errors and inflates Loki
	     ingestion. -->
	<logger name="net.lightbody" level="WARN"/>
	<logger name="com.browserup" level="WARN"/>
	<logger name="io.netty" level="WARN"/>

	<!-- Enable DEBUG for our utility classes -->
	<logger name="primemover.util" level="DEBUG"/>
	<logger name="primemover.lambda" level="DEBUG"/>
	<logger name="primemover.runner" level="DEBUG"/>

	<springProfile name="dev,staging,test,local">
		<root level="DEBUG">
			<appender-ref ref="CONSOLE" />
			<appender-ref ref="FILE" />
		</root>
	</springProfile>
	<springProfile name="production">
		<root level="INFO">
			<appender-ref ref="CONSOLE" />
			<appender-ref ref="FILE" />
		</root>
	</springProfile>
	<!-- Default profile (no profile specified) -->
	<springProfile name="default">
		<root level="INFO">
			<appender-ref ref="CONSOLE" />
			<appender-ref ref="FILE" />
		</root>
	</springProfile>

 </configuration>
# Runner secrets — copy to secrets.properties (gitignored) and fill in.
# Imported by application.properties via:
#   spring.config.import=optional:file:./config/secrets.properties
# Values here OVERRIDE the blank placeholders in application.properties, which is
# kept secret-free. NEVER commit the real secrets.properties.
#
#   chmod 600 secrets.properties   # after creating it

# --- S3 object store (job data + final source upload) ---
# The key must belong to the account that owns bucket "primemoverrunner", with
# s3:PutObject on reports/* and finalsource/*. A key for any other
# account/bucket yields NoSuchBucket / AccessDenied instead of working. Leave
# blank to run without S3 upload (job data still lands on local disk when
# storage.local.enabled=true; use the spool-and-drain sidecar for off-host copies).
awsS3.accessKey=
awsS3.secretKey=
# Endpoint and region are host-specific, which is why they live here rather than
# in the tracked application.properties:
#   - Real AWS: leave endpoint blank; set region to the bucket's region
#     (eu-central-1 is the built-in default when unset).
#   - MinIO / other S3-compatible store: set the endpoint URL. The client then
#     switches to path-style addressing automatically. MinIO ignores region, but
#     the SDK still requires a valid one.
# An endpoint pointing at a host-local or tailnet-only store will not resolve
# from other machines — keep it per-host, never in tracked config.
awsS3.endpoint=
awsS3.region=

# --- API backend (runner <-> primemover_api) ---
backend.password=

# --- Multilogin X ---
multilogin.apiPassword=

# --- Recorder MITM CA cert (only used when recorder.enabled=true) ---
recorder.certificate.password=

# --- GeoSurf proxy (legacy/retired) ---
geosurf.overwrite.password=

# --- Anti-Captcha (only used when anticaptcha.enabled=true) ---
anticaptcha.api.key=

# Runner secrets — copy to secrets.properties (gitignored) and fill in.
# Imported by application.properties via:
#   spring.config.import=optional:file:./config/secrets.properties
# Values here OVERRIDE the blank placeholders in application.properties, which is
# kept secret-free. NEVER commit the real secrets.properties.
#
#   chmod 600 secrets.properties   # after creating it

# --- AWS S3 (job data + final source upload) ---
# The key must belong to the account that owns bucket "primemoverrunner" in
# eu-central-1 (region is hardcoded), with s3:PutObject on reports/* and
# finalsource/*. A key for any other account/bucket yields NoSuchBucket /
# AccessDenied instead of working. Leave blank to run without S3 upload (job data
# still lands on local disk; use the spool-and-drain sidecar for off-host copies).
awsS3.accessKey=
awsS3.secretKey=

# --- API backend (runner <-> primemover_api) ---
backend.password=

# --- Multilogin X ---
multilogin.apiPassword=

# --- Recorder MITM CA cert (only used when recorder.enabled=true) ---
recorder.certificate.password=

# --- GeoSurf proxy (legacy/retired) ---
geosurf.overwrite.password=

# --- Anti-Captcha (only used when anticaptcha.enabled=true) ---
anticaptcha.api.key=

{
	"name": "%%AGENTID%%",
	"os": "%%OS%%",
	"browser": "%%BROWSER%%",
	"core_version": 149,
	"network": {
		"proxy": {
			"type": "%%PROXYTYPE%%",
			"host": "%%PROXYHOST%%",
			"port": "%%PROXYPORT%%",
			"username": "%%PROXYUSERNAME%%",
			"password": "%%PROXYPASSWORD%%"
		},
